# Template de .env pra produção (TimoSRV). Copiar para .env no servidor e
# preencher os valores marcados com <<...>>. Não commitar o .env real —
# este arquivo é só um modelo, sem segredos.

APP_NAME=IgnControl
APP_ENV=production
# Gerar com `php artisan key:generate --force` DEPOIS de copiar este
# arquivo pra .env no servidor — nunca reaproveitar a APP_KEY de dev.
APP_KEY=
APP_DEBUG=false
APP_URL=https://<<seu-dominio-ou-subdominio-no-cloudflare>>

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# Em produção não queremos debug nem stack trace nenhum vazando — só log
# em arquivo, nível "error" (não "debug").
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=igncontrol
DB_USERNAME=<<usuario_mysql>>
DB_PASSWORD=<<senha_forte_mysql>>

SESSION_DRIVER=database
SESSION_LIFETIME=120
# true porque em produção o acesso é sempre via HTTPS (Cloudflare Tunnel).
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=smtp
MAIL_HOST=<<smtp-do-provedor-de-email>>
MAIL_PORT=587
MAIL_USERNAME=<<usuario_smtp>>
MAIL_PASSWORD=<<senha_smtp>>
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="naoresponda@<<seu-dominio>>"
MAIL_FROM_NAME="${APP_NAME}"

# Backup (ver docs/backup-restore.md) — ajustar os caminhos ao que for
# instalado no TimoSRV.
DB_DUMP_BINARY_PATH="C:\xampp\mysql\bin\"
BACKUP_DISK_PATH="C:\xampp\htdocs\IgnControl_Laravel\storage\app\backups"
BACKUP_NOTIFICATION_EMAIL=<<seu-email-de-alerta>>

VITE_APP_NAME="${APP_NAME}"
